<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application>
        <meta-data android:name="com.google.android.gms.cast.framework.OPTIONS_PROVIDER_CLASS_NAME"
            android:value="com.infinifolder.audio.cast.StandardCastOptions" />
        <receiver android:name="androidx.mediarouter.media.MediaTransferReceiver" android:exported="true" />
        <activity android:name="com.infinifolder.audio.cast.CastRouteActivity"
            android:exported="false" android:theme="@style/CastRouteTheme" />
        <activity
            android:name="com.infinifolder.viewer.AudioPlayerActivity"
            android:exported="false"
            android:configChanges="orientation|screenSize|uiMode"
            android:launchMode="singleTop"
            android:theme="@style/AppTheme" />
        <service
            android:name="com.infinifolder.viewer.AudioPlayerService"
            android:exported="false"
            android:foregroundServiceType="mediaPlayback" />
        <receiver
            android:name="com.infinifolder.viewer.WinampMiniPlayerWidgetProvider"
            android:label="@string/winamp_mini_player_widget_label"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
                <action android:name="com.infinifolder.viewer.action.REFRESH_MINI_PLAYER_WIDGET" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/winamp_mini_player_widget_info" />
        </receiver>
    </application>
</manifest>
